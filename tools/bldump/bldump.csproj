<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool, not part of the mod or the solution: lists members of Bannerlord 1.4.8 types from the
       reference assemblies (which have no method bodies), to check that an API exists before using it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bldump</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Bannerlord (Steam / GOG / Epic) runs on .NET Framework 4.7.2. -->
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>BannerlordMP</RootNamespace>
    <AssemblyName>BannerlordMP</AssemblyName>
    <ModuleId>BannerlordMP</ModuleId>
    <GameVersion>1.4.8.119303</GameVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Set this (e.g. dotnet build -p:GameFolder="C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord")
         to copy the built module straight into the game's Modules folder. -->
    <GameFolder Condition="'$(GameFolder)' == ''"></GameFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-only references to the game. The real assemblies come from the game install at runtime. -->
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="$(GameVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Harmony is provided at runtime by the Bannerlord.Harmony module (a declared dependency). -->
    <PackageReference Include="Lib.Harmony" Version="2.2.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BannerlordMP.Core\BannerlordMP.Core.csproj" />
  </ItemGroup>

  <!-- Lay the build out as a ready-to-install Bannerlord module: artifacts/Modules/BannerlordMP -->
  <Target Name="PackageModule" AfterTargets="Build">
    <PropertyGroup>
      <ModuleDir>$(MSBuildThisFileDirectory)..\..\artifacts\Modules\$(ModuleId)\</ModuleDir>
      <ModuleBinDir>$(ModuleDir)bin\Win64_Shipping_Client\</ModuleBinDir>
    </PropertyGroup>
    <ItemGroup>
      <ModuleBinaries Include="$(OutDir)BannerlordMP.dll;$(OutDir)BannerlordMP.pdb;$(OutDir)BannerlordMP.Core.dll;$(OutDir)BannerlordMP.Core.pdb;$(OutDir)LiteNetLib.dll" />
      <ModuleFiles Include="_Module\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleFiles)" DestinationFiles="@(ModuleFiles->'$(ModuleDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModuleBinaries)" DestinationFolder="$(ModuleBinDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
    <ItemGroup Condition="'$(GameFolder)' != ''">
      <PackagedModule Include="$(ModuleDir)**\*" />
    </ItemGroup>
    <Copy Condition="'$(GameFolder)' != ''" SourceFiles="@(PackagedModule)" DestinationFiles="@(PackagedModule->'$(GameFolder)\Modules\$(ModuleId)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>

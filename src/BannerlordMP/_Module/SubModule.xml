<?xml version="1.0" encoding="utf-8"?>
<Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/BUTR/Bannerlord.XmlSchemas/master/SubModule.xsd">
  <Id value="BannerlordMP"/>
  <Name value="Bannerlord MP Campaign"/>
  <Version value="v0.3.10"/>
  <DefaultModule value="false"/>
  <ModuleCategory value="Singleplayer"/>
  <ModuleType value="Community"/>
  <!-- Hard requirements: only the base game modules. Harmony ships inside this module (0Harmony.dll). -->
  <DependedModules>
    <DependedModule Id="Native"/>
    <DependedModule Id="SandBoxCore"/>
    <DependedModule Id="Sandbox"/>
  </DependedModules>
  <!-- Community dependency metadata (read by BLSE / Bannerlord Mod Manager, ignored by the official launcher):
       load after Harmony and StoryMode when they are present, but neither is required. -->
  <DependedModuleMetadatas>
    <DependedModuleMetadata id="Bannerlord.Harmony" order="LoadBeforeThis" optional="true"/>
    <DependedModuleMetadata id="Native" order="LoadBeforeThis"/>
    <DependedModuleMetadata id="SandBoxCore" order="LoadBeforeThis"/>
    <DependedModuleMetadata id="Sandbox" order="LoadBeforeThis"/>
    <DependedModuleMetadata id="StoryMode" order="LoadBeforeThis" optional="true"/>
  </DependedModuleMetadatas>
  <SubModules>
    <SubModule>
      <Name value="BannerlordMP"/>
      <DLLName value="BannerlordMP.dll"/>
      <SubModuleClassType value="BannerlordMP.SubModule"/>
      <Assemblies>
        <Assembly value="0Harmony.dll"/>
        <Assembly value="LiteNetLib.dll"/>
        <Assembly value="BannerlordMP.Core.dll"/>
      </Assemblies>
      <Tags/>
    </SubModule>
  </SubModules>
  <Xmls/>
</Module>
